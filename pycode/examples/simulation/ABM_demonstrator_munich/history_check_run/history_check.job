#!/bin/bash

#SBATCH -J "ABM_history_check"
#SBATCH -o log_history_check_%j.out
#SBATCH -p cn
#SBATCH -N 1
#SBATCH -c 1
#SBATCH --mem 20G
#SBATCH --time 01:30:00

export OMP_NUM_THREADS=1
export OMP_DYNAMIC=FALSE
export PYTHONUNBUFFERED=1
export KAPPA_FACTOR=2.2

python history_check.py
echo "Python exit code: $?"